digraph internal_deps {

 graph [rankdir=LR];
 edge [fontname="Courier New", fontsize=8, color="#555"];
 graph  [fontname="Helvetica", fontsize=12];
 node [
    shape=box
    style=filled
    fontname="Helvetica"
    fontsize=12
    fillcolor="white"
    color="#555"
 ];
 
  compound=true;
  node [shape=box];
  subgraph "cluster_app" {
    label="app";
    style="rounded,filled";
    color="#1f77b4";
    fillcolor="#c6dbef";
    "app";
  }
  subgraph "cluster_clients" {
    label="clients";
    style="rounded,filled";
    color="#ff7f0e";
    fillcolor="#ffe7c6";
    "clients";
  }
  subgraph "cluster_containers" {
    label="containers";
    style="rounded,filled";
    color="#2ca02c";
    fillcolor="#c6efcd";
    "containers::physure_helper";
    "containers::spectrum";
    "containers::roi::roi_event";
    "containers::nuclide";
    "containers::roi::roi";
    "containers::roi";
    "containers::converters";
    "containers::instrument";
    "containers::roi::roi_view_state";
    "containers";
    "containers::roi::roi_view";
  }
  subgraph "cluster_core" {
    label="core";
    style="rounded,filled";
    color="#d62728";
    fillcolor="#f4c6c6";
    "core::nuclide_library";
    "core";
    "core::spectogram_manager";
    "core::instrument_library";
    "core::roi_manager";
    "core::io_manager";
    "core::spectrum_manager";
    "core::run_manager";
  }
  subgraph "cluster_crate" {
    label="crate";
    style="rounded,filled";
    color="#9467bd";
    fillcolor="#e8d6ef";
    "crate";
  }
  subgraph "cluster_gui" {
    label="gui";
    style="rounded,filled";
    color="#8c564b";
    fillcolor="#e9d6ca";
    "gui::menu_bar";
    "gui::plot_screen";
    "gui";
    "gui::modals";
    "gui::spectrum_plot";
  }
  subgraph "cluster_logging" {
    label="logging";
    style="rounded,filled";
    color="#e377c2";
    fillcolor="#f7d6e9";
    "logging";
  }
  subgraph "cluster_main" {
    label="main";
    style="rounded,filled";
    color="#7f7f7f";
    fillcolor="#d6d6d6";
    "main";
  }
  subgraph "cluster_settings" {
    label="settings";
    style="rounded,filled";
    color="#bcbd22";
    fillcolor="#ecebc6";
    "settings";
  }
  subgraph "cluster_spectogram" {
    label="spectogram";
    style="rounded,filled";
    color="#17becf";
    fillcolor="#c6eef0";
    "spectogram";
  }
  subgraph "cluster_theme_manager" {
    label="theme_manager";
    style="rounded,filled";
    color="#1f77b4";
    fillcolor="#c6dbef";
    "theme_manager";
  }
  subgraph "cluster_utils" {
    label="utils";
    style="rounded,filled";
    color="#ff7f0e";
    fillcolor="#ffe7c6";
    "utils::numerics::polyfit";
    "utils::file_io::db_converter";
    "utils::file_io";
    "utils::file_io::tka_parser";
    "utils::file_io::export";
    "utils::numerics::efficiency";
    "utils::file_io::n42_writer";
    "utils::file_io::spe_parser";
    "utils::numerics";
